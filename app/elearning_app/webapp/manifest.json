{
  "_version": "1.90.0",
  "sap.app": {
    "id": "elearningapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.6"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.34.0",
      "toolsId": "3ba14d7f-2821-4f13-a715-b00462ad4587"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/e-learning/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "elearningapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CatagoriesList",
          "target": "CatagoriesList"
        },
        {
          "pattern": "Catagories({key}):?query:",
          "name": "CatagoriesObjectPage",
          "target": "CatagoriesObjectPage"
        },
        {
          "pattern": "Catagories({key})/Courses({key2}):?query:",
          "name": "CoursesObjectPage",
          "target": "CoursesObjectPage"
        }
      ],
      "targets": {
        "CatagoriesList": {
          "type": "Component",
          "id": "CatagoriesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Catagories",
              "variantManagement": "Page",
              "navigation": {
                "Catagories": {
                  "detail": {
                    "route": "CatagoriesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "CatagoriesObjectPage": {
          "type": "Component",
          "id": "CatagoriesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Catagories",
              "navigation": {
                "Courses": {
                  "detail": {
                    "route": "CoursesObjectPage"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "DescriptionFacet": {
                      "useSingleTextAreaFieldAsNotes": true
                    }
                  }
                }
              },
              "controlConfiguration": {
                "Courses/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "Inline",
                      "createAtEnd": false
                    }
                  },
                  "columns": {
                    "CourseActions": {
                      "header": "Actions",
                      "template": "elearningapp.ext.CourseActions",
                      "width": "8rem",
                      "horizontalAlign": "Center"
                    }
                  },
                  "actions": {
                    "CreateCourseDisplay": {
                      "text": "Create",
                      "press": "elearningapp.ext.CourseActions.onCreateInDisplay",
                      "visible": "{= !${ui>/isEditable} && ${/AppSettings/readOnly} === false }",
                      "enabled": true,
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "CoursesObjectPage": {
          "type": "Component",
          "id": "CoursesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Catagories/Courses"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "elearningapp.ext.PageExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "elearningapp.ext.PageExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ManageAppRouter"
  }
}
