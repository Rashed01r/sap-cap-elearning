{
  "name": "e_learning",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "express-rate-limit": "8.7.3"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-elearning_app": "cds watch --open elearningapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy e_learning --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "admin": "CDS_REQUIRES_AUTH_KIND=mocked cds watch --profile hybrid --open elearningapp/index.html",
    "reset-data": "cds deploy --to sqlite:db.sqlite"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "dummy"
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    },
    "server": {
      "index": true
    },
    "fiori": {
      "[production]": {
        "preview": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/elearning_app"
  ]
}
